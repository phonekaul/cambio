# Required: your Anthropic API key (server-side only, never sent to the browser)
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Optional model overrides.
# The decision model picks between close options and writes the "thoughts" (called often, so keep it fast).
# The summary model writes the end-of-game read on you (called once).
AI_DECISION_MODEL=claude-haiku-4-5-20251001
AI_SUMMARY_MODEL=claude-sonnet-5-5

# Optional abuse guards for a public link (in-memory, best effort)
AI_RATE_PER_HOUR=600
AI_DAILY_CAP=6000

# Dev only: skip the LLM entirely (the engine's top-ranked move is played with template thoughts)
# AI_MOCK=1
